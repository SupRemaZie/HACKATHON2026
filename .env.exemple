###############################################################################
# .env – Hackathon 2026 : Empreinte Carbone
# Variables utilisées par docker-compose.yml
# Modifier les valeurs ci-dessous selon votre environnement.
###############################################################################

# ---- PostgreSQL ----
POSTGRES_USER=carbon
POSTGRES_PASSWORD=carbon
POSTGRES_DB=carbon_db
POSTGRES_PORT=5432

# ---- Frontend React + Next.js ----
FRONTEND_PORT=3000
NODE_VERSION=22
BACKEND_URL=http://backend:8080

# ---- Backend Spring Boot ----
BACKEND_PORT=8080

# ---- JPA / Hibernate ----
# update  = met à jour le schéma automatiquement (dev)
# validate = vérifie le schéma sans le modifier (prod)
# create-drop = recrée le schéma à chaque démarrage (tests)
DDL_AUTO=update
SHOW_SQL=false

# ---- JWT ----
JWT_SECRET=h4ck4th0n2026_s3cr3t_k3y_ch4ng3_m3!
JWT_EXPIRATION_MS=3600000

# ---- JVM ----
JAVA_TOOL_OPTIONS=-Dfile.encoding=UTF-8 -Xms256m -Xmx512m

# ---- Spring DevTools ----
DEVTOOLS_RESTART=true
